{
  "name": "wizard-arena-plus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,party -c blue,magenta \"next dev\" \"partykit dev\"",
    "dev:next": "next dev",
    "dev:party": "partykit dev",
    "build": "next build",
    "build:android": "cross-env NEXT_OUTPUT_MODE=export next build",
    "sync:android": "npm run build:android && npx cap sync android",
    "start": "next start",
    "deploy:party": "partykit deploy",
    "test": "playwright test",
    "test:codec": "node --no-warnings --experimental-strip-types --loader ./tools/ts-loader.mjs shared/snapshot-codec.test.mts",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@supabase/supabase-js": "^2.107.0",
    "next": "^15.0.0",
    "partysocket": "^1.0.2",
    "phaser": "^3.87.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "partykit": "^0.0.114",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0"
  }
}
